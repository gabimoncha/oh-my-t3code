{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/gabimoncha/oh-my-t3/main/schema/omt.schema.json",
  "title": "oh-my-t3 config",
  "description": "A user (~/.config/oh-my-t3code/config.jsonc) or project (.omt/config.jsonc) config layer.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "version": {
      "const": 1
    },
    "defaults": {
      "deprecated": true,
      "description": "No longer used. omt ignores this key."
    },
    "profile": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,31}$",
      "description": "Default workflow profile. Default normal."
    },
    "profiles": {
      "type": "object",
      "description": "Profile overrides and new profiles. A new profile needs a description. Null removes a custom profile.",
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9-]{0,31}$"
      },
      "properties": {
        "normal": {
          "$ref": "#/$defs/profile"
        },
        "prototype": {
          "$ref": "#/$defs/profile"
        },
        "pr-review": {
          "$ref": "#/$defs/profile"
        }
      },
      "additionalProperties": {
        "oneOf": [
          {
            "type": "null"
          },
          {
            "$ref": "#/$defs/profile"
          }
        ]
      }
    },
    "models": {
      "type": "object",
      "propertyNames": {
        "minLength": 1,
        "maxLength": 200
      },
      "additionalProperties": {
        "$ref": "#/$defs/model"
      }
    },
    "roles": {
      "type": "object",
      "description": "Role overrides and new roles. Set a role to null to remove it.",
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9-]{0,31}$"
      },
      "additionalProperties": {
        "oneOf": [
          {
            "type": "null"
          },
          {
            "$ref": "#/$defs/role"
          }
        ]
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "maxParallel": {
          "type": "integer",
          "minimum": 1,
          "maximum": 32,
          "description": "Most child tasks that run at the same time."
        },
        "maxDepth": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3,
          "description": "Most levels of delegation below the main thread."
        },
        "maxReviewRounds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10,
          "description": "Most review rounds for one change."
        },
        "maxTasksPerRun": {
          "deprecated": true,
          "description": "No longer used. omt ignores this key."
        }
      }
    },
    "visuals": {
      "deprecated": true,
      "description": "No longer used. omt ignores this key."
    },
    "update": {
      "enum": [
        "off",
        "check",
        "apply"
      ],
      "description": "Check for a new omt once a day in omt install and omt doctor (asks the npm registry). apply also applies a found update. Read only from the user config. Default off."
    },
    "harnesses": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-zA-Z][a-zA-Z0-9_-]{0,63}$"
      },
      "description": "T3 driver kinds that routing may use, for example [\"codex\"]. A rung of another driver fails. Without it, every driver may run. Run omt detect to set it."
    }
  },
  "$defs": {
    "role": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "access": {
          "enum": [
            "read-only",
            "edit"
          ]
        },
        "result": {
          "enum": [
            "work",
            "review",
            "test",
            "research",
            "plan",
            "guardrail",
            "grill"
          ]
        },
        "t3Role": {
          "enum": [
            "implementation",
            "research",
            "review",
            "design",
            "test",
            "general"
          ]
        },
        "interactionMode": {
          "enum": [
            "inherit",
            "default",
            "plan"
          ]
        },
        "runtimeMode": {
          "enum": [
            "inherit",
            "approval-required",
            "auto-accept-edits",
            "auto",
            "full-access"
          ]
        },
        "crossFamily": {
          "type": "boolean",
          "description": "With --against, try the rungs outside the worker's family first."
        },
        "fast": {
          "type": "boolean"
        },
        "chain": {
          "type": "array",
          "minItems": 1,
          "maxItems": 10,
          "items": {
            "$ref": "#/$defs/rung"
          }
        }
      }
    },
    "rung": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model"
      ],
      "anyOf": [
        {
          "required": [
            "provider"
          ]
        },
        {
          "required": [
            "driver"
          ]
        }
      ],
      "properties": {
        "provider": {
          "type": "string",
          "pattern": "^[a-zA-Z][a-zA-Z0-9_-]{0,63}$",
          "description": "T3 provider instance id."
        },
        "driver": {
          "type": "string",
          "pattern": "^[a-zA-Z][a-zA-Z0-9_-]{0,63}$",
          "description": "T3 driver kind."
        },
        "model": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "effort": {
          "enum": [
            "off",
            "minimal",
            "low",
            "medium",
            "high",
            "xhigh",
            "max"
          ]
        },
        "fast": {
          "type": "boolean"
        },
        "options": {
          "type": "object",
          "additionalProperties": {
            "type": [
              "string",
              "boolean"
            ]
          }
        }
      }
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "fast": {
          "type": "boolean"
        }
      }
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "extends": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{0,31}$"
        },
        "workflow": {
          "$ref": "#/$defs/workflow"
        },
        "limits": {
          "$ref": "#/properties/limits"
        },
        "roles": {
          "$ref": "#/properties/roles"
        },
        "models": {
          "$ref": "#/properties/models"
        }
      }
    },
    "workflow": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "plan": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "review": {
              "enum": [
                "two-families",
                "one",
                "owner"
              ]
            },
            "testLayers": {
              "type": "array",
              "items": {
                "enum": [
                  "e2e",
                  "integration",
                  "unit"
                ]
              }
            }
          }
        },
        "design": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "variants": {
              "type": "integer",
              "minimum": 1,
              "maximum": 5
            }
          }
        },
        "build": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "review": {
              "enum": [
                "every-round",
                "first-round",
                "off"
              ]
            },
            "qa": {
              "enum": [
                "planned",
                "off"
              ]
            },
            "failureProofs": {
              "enum": [
                "on",
                "off"
              ]
            },
            "oracle": {
              "enum": [
                "heavy",
                "always",
                "off"
              ]
            },
            "verify": {
              "deprecated": true,
              "description": "No longer used. omt ignores this key."
            },
            "checkpoint": {
              "deprecated": true,
              "description": "No longer used. omt ignores this key."
            },
            "stallMinutes": {
              "deprecated": true,
              "description": "No longer used. omt ignores this key."
            }
          }
        },
        "review": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "reviewers": {
              "oneOf": [
                {
                  "const": "auto"
                },
                {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 4
                }
              ]
            },
            "families": {
              "enum": [
                "one",
                "both"
              ]
            },
            "oracle": {
              "enum": [
                "on",
                "off"
              ]
            },
            "fixLoop": {
              "enum": [
                "offer",
                "off"
              ]
            },
            "ci": {
              "enum": [
                "off",
                "check",
                "fix"
              ]
            },
            "verify": {
              "enum": [
                "off",
                "changed-flows"
              ]
            },
            "tests": {
              "enum": [
                "off",
                "offer"
              ]
            },
            "guardrails": {
              "enum": [
                "off",
                "propose"
              ]
            },
            "crap": {
              "enum": [
                "off",
                "report"
              ]
            }
          }
        },
        "git": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "branchCommits": {
              "enum": [
                "auto",
                "ask"
              ]
            },
            "pullRequests": {
              "enum": [
                "auto",
                "ask",
                "off"
              ]
            },
            "defaultBranch": {
              "enum": [
                "ask",
                "auto"
              ]
            },
            "merge": {
              "enum": [
                "ask",
                "auto"
              ]
            },
            "owners": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9-]{0,38}$"
              }
            },
            "maxPrFiles": {
              "type": "integer",
              "minimum": 0,
              "maximum": 10000
            }
          }
        }
      }
    }
  }
}

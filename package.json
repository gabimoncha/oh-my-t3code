{
  "name": "oh-my-t3code",
  "version": "0.2.0",
  "private": true,
  "description": "Roles, briefs, plans, and review loops for agents that run in T3 Code.",
  "type": "module",
  "license": "MIT",
  "repository": "github:gabimoncha/oh-my-t3code",
  "homepage": "https://oh-my-t3code.pages.dev",
  "packageManager": "bun@1.4.4",
  "bin": {
    "omt": "dist/cli.js",
    "oh-my-t3code": "dist/cli.js"
  },
  "files": [
    "dist",
    "skills",
    "schema",
    "assets",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "bun": ">=1.4.4"
  },
  "scripts": {
    "omt": "bun src/cli.ts",
    "test": "bun test",
    "typecheck": "sh scripts/tsrs.sh -p tsconfig.json",
    "schema": "bun scripts/build-schema.ts",
    "build": "bun scripts/build.ts",
    "release": "bun scripts/release.ts",
    "verify": "bun run typecheck && bun test"
  },
  "devDependencies": {
    "@types/bun": "^1.4.3",
    "tsrs": "0.18.0-ts7.1.0-dev.20260929"
  }
}
